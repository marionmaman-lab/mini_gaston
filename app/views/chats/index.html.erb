<div class="conversations-page">

  <header class="conversations-header">
    <div>
      <span class="conversations-brand">🍃 MINI GASTON</span>
      <h1>Bonjour <%= current_user.first_name %> !</h1>
      <p>Qu'est-ce qu'on cuisine aujourd'hui ?</p>
    </div>
  </header>

  <main class="conversations-content">

    <section class="conversations-intro">
      <div>
        <h2>Mes conversations</h2>
        <p>Retrouvez vos échanges avec votre assistant culinaire.</p>
      </div>

      <%= button_to "＋ Nouvelle conversation",
          chats_path,
          method: :post,
          params: { from: "conversations" },
          class: "conversations-new-button" %>
    </section>

    <% if @chats.any? %>
      <div class="conversations-list">
        <% @chats.each do |chat| %>
          <%= link_to chat_path(chat, from: "conversations"), class: "conversation-card" do %>
            <div class="conversation-icon">💬</div>

            <div class="conversation-info">
              <h3><%= chat.display_title %></h3>
              <p>Ouvrir la conversation</p>
            </div>

            <span class="conversation-arrow">→</span>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="conversations-empty">
        <span>🥕</span>
        <h3>Pas encore de conversation</h3>
        <p>Lancez votre première discussion avec Mini Gaston !</p>
      </div>
    <% end %>

  </main>
</div>
