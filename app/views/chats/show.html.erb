<div class=“container mt-4” style=“max-width: 800px;“>
  <%= link_to “← Mes conversations”, chats_path, class: “text-muted” %>

  <h1 class=“h3 my-3”><%= @chat.title %></h1>

  <div id=“messages”>
    <% @chat.messages.each do |message| %>
      <% if message.role == “user” %>
        <div class=“d-flex justify-content-end mb-3">
          <div class=“bg-dark text-white px-3 py-2 rounded-4”>
            <%= message.content %>
          </div>
        </div>
      <% else %>
        <div class=“d-flex justify-content-start mb-3">
          <div class=“bg-light px-3 py-2 rounded-4”>
            <%= raw(render_markdown(message.content)) %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>

  <%= simple_form_for [@chat, @message] do |f| %>
    <%= f.input :content, label: false, placeholder: “Quels ingrédients as-tu dans ton frigo ?” %>
    <%= f.button :submit, “Envoyer”, class: “btn btn-dark” %>
  <% end %>
</div>
