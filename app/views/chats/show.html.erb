<%# Le bouton "Retour" s'affiche seulement si on vient d'une autre conversation ou de la liste %>
<% show_back = (@back_chat && @back_chat != @chat) || params[:from] == "conversations" %>

<div class="chat-page" data-controller="toggle">

  <%= turbo_stream_from @chat %>

  <div class="chat-layout">

    <!-- HISTORIQUE -->
    <aside class="chat-history <%= 'd-none' unless params[:history] == 'open' %>"
           data-toggle-target="hideable">

      <div class="history-header">
        <div>
          <span class="history-label">MINI GASTON</span>
          <h2>Historique</h2>
        </div>

        <!-- Croix pour fermer : ne se confond plus avec la flèche "Retour" -->
        <button type="button"
                class="history-close"
                title="Fermer l'historique"
                data-action="click->toggle#call">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <% if @chats.any? %>
        <ul class="history-list">
          <% @chats.each do |chat| %>
            <li class="history-item <%= 'active' if chat == @chat %>">

              <div class="history-item-info">
                <%= link_to chat.display_title,
                      chat_path(chat,
                                history: "open",
                                from: params[:from],
                                back_to: (@chat.id unless chat == @chat)),
                      class: "history-item-link #{'active' if chat == @chat}" %>

                <small>
                  Il y a <%= time_ago_in_words(chat.created_at) %>
                </small>
              </div>

              <%= button_to chat_path(chat),
                    method: :delete,
                    params: { current_chat_id: @chat.id },
                    class: "history-delete-button",
                    form: { data: { turbo_confirm: "Supprimer cette conversation ?" } } do %>
                <i class="fa-solid fa-trash-can"></i>
              <% end %>

            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="history-empty">Pas encore de conversation.</p>
      <% end %>

    </aside>

    <!-- ZONE PRINCIPALE DU CHAT -->
    <main class="chat-main">

      <!-- HEADER -->
      <header class="chat-topbar">

        <div class="chat-topbar-left">

          <!-- Retour : revient à la page précédente, comme la flèche du navigateur -->
          <% if show_back %>
            <button type="button"
                    class="history-open-button"
                    title="Revenir à la page précédente"
                    onclick="history.back()">
              <i class="fa-solid fa-arrow-left"></i>
              Retour
            </button>
          <% end %>

          <button type="button"
                  class="history-open-button <%= 'd-none' if params[:history] == 'open' %>"
                  title="Afficher l'historique"
                  data-toggle-target="hideable"
                  data-action="click->toggle#call">
            <i class="fa-solid fa-clock-rotate-left"></i>
            Historique
          </button>

          <div class="chat-title-block">
            <span class="chat-brand">🍃 MINI GASTON</span>
            <h1><%= @chat.display_title %></h1>
          </div>

        </div>

        <!-- Nouvelle conversation : mémorise d'où l'on vient pour le "Retour" -->
        <%= button_to chats_path,
              params: { back_to: (@chat.id if @chat.messages.any?), from: params[:from] }.compact,
              class: "history-open-button",
              title: "Nouvelle conversation",
              form_class: "chat-topbar-right" do %>
          <i class="fa-solid fa-plus"></i>
          Nouvelle conversation
        <% end %>

      </header>

      <!-- CONTENEUR DES MESSAGES -->
      <section class="chat-container">

        <div id="messages" class="chat-messages" data-controller="scroll">

          <% if @chat.messages.empty? %>
            <div class="chat-welcome">
              <span>👋</span>
              <h2>Bonjour ! Que cuisine-t-on aujourd'hui ?</h2>
              <p>
                Dis-moi ce que tu as dans ton frigo,
                je vais t'aider à trouver une recette.
              </p>
            </div>
          <% end %>

          <% @chat.messages.each do |message| %>
            <%= render "messages/message", message: message, chat: @chat %>
          <% end %>

        </div>

        <!-- BARRE DE SAISIE -->
        <div id="new_message_container" class="chat-form-container">
          <%= render "messages/form", chat: @chat, message: @message %>
        </div>

      </section>

      <div class="chat-footer">
        <span>🍃</span>
        <p>Mini Gaston, ton compagnon cuisine au quotidien.</p>
      </div>

    </main>

  </div>
</div>
