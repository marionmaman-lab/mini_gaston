<div class="chat-page">

  <!-- HEADER -->
  <header class="chat-header">
    <div>
      <span class="chat-brand">🍃 MINI GASTON</span>
      <h1><%= @chat.title %></h1>
      <p>Votre assistant culinaire est à votre écoute.</p>
    </div>

    <%= link_to "← Mes conversations", chats_path, class: "chat-back-link" %>
  </header>

  <!-- CONVERSATION -->
  <main class="chat-container">

    <div class="chat-messages" id="messages">

      <% if @chat.messages.empty? %>
        <div class="chat-welcome">
          <span>👋</span>
          <h2>Bonjour ! Que cuisine-t-on aujourd'hui ?</h2>
          <p>Dis-moi ce que tu as dans ton frigo, je vais t'aider à trouver une recette.</p>
        </div>
      <% end %>

      <% @chat.messages.each do |message| %>

        <% if message.role == "user" %>
          <div class="message-row user-message">
            <div class="message-bubble">
              <%= message.content %>
            </div>
          </div>
        <% else %>
          <div class="message-row assistant-message">
            <div class="assistant-avatar">🍃</div>
            <div class="message-bubble">
              <%= sanitize(render_markdown(message.content)) %>
            </div>
          </div>
        <% end %>

      <% end %>

    </div>

   <!-- FORMULAIRE -->
<div class="chat-form-container">
  <%= simple_form_for [@chat, @message] do |f| %>

    <%= f.input_field :content,
      as: :text,
      class: "chat-input",
      placeholder: "Quels ingrédients as-tu dans ton frigo ?",
      rows: 2 %>

    <%= f.button :submit, "Envoyer →", class: "chat-send-button" %>

  <% end %>
</div>

</div>

  </main>

</div>
