<div class="login-page">
  <div class="login-card">

    <div class="login-header">
      <span class="login-label">🍃 MINI GASTON</span>
      <h1>Bienvenue !</h1>
      <p>Connecte-toi pour retrouver tes conversations.</p>
    </div>

    <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>

      <div class="login-form">
        <%= f.input :email,
                    label: "Adresse email",
                    required: false,
                    autofocus: true,
                    input_html: { autocomplete: "email", placeholder: "ton@email.com" } %>

        <%= f.input :password,
                    label: "Mot de passe",
                    required: false,
                    input_html: { autocomplete: "current-password", placeholder: "Ton mot de passe" } %>

        <%= f.input :remember_me, as: :boolean if devise_mapping.rememberable? %>
      </div>

      <div class="login-actions">
        <%= f.button :submit, "Se connecter", class: "login-submit" %>
      </div>

    <% end %>

    <div class="login-links">
      <%= render "devise/shared/links" %>
    </div>

  </div>
</div>
