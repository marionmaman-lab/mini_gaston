
<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Mini Gaston" %></title>

    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Mini Gaston">
    <meta name="mobile-web-app-capable" content="yes">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>

    <%= link_to "Skip to main content",
        "#main-content",
        class: "visually-hidden-focusable" %>

    <% hide_navbar = devise_controller? &&
        ["sessions", "registrations"].include?(controller_name) &&
        ["new", "create"].include?(action_name) %>

    <!-- NAVBAR LATERALE -->

    <% unless hide_navbar %>
      <header>
        <%= render "shared/navbar" %>
      </header>
    <% end %>

    <!-- MESSAGES FLASH -->

    <%= render "shared/flashes" %>

    <!-- CONTENU PRINCIPAL -->

    <main id="main-content"
          class="<%= 'app-content' unless hide_navbar %>">

      <%= yield %>

    </main>

  </body>
</html>
