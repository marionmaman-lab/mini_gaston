
<div class="recipe-detail-page">

  <!-- HERO -->
  <section class="recipe-detail-hero">

    <div class="detail-hero-content">
        <!-- NAVIGATION -->
      <div class="recipe-back">
        <%= link_to root_path, class: "recipe-back-link" do %>
          <span>←</span> Toutes les recettes
        <% end %>
      </div>

      <span class="detail-label">
        🍃 MINI GASTON · LE PLAISIR DE CUISINER
      </span>

      <h1><%= @recipe.title %></h1>

      <div class="detail-badges">
        <div class="detail-badge">
          <span>⏱️</span>
          <div>
            <small>Préparation</small>
          <strong><%= format_duration(@recipe.duration_in_minutes) %></strong>
          </div>
        </div>

        <div class="detail-badge">
          <span>👥</span>
          <div>
            <small>Portions</small>
            <strong><%= @recipe.servings %> personnes</strong>
          </div>
        </div>

        <div class="detail-badge">
          <span>⭐</span>
          <div>
            <small>Difficulté</small>
            <strong><%= @recipe.difficulty.presence || "Non précisée" %></strong>
          </div>
        </div>
      </div>
    </div>

    <div class="detail-hero-illustration">
      <span>🍝</span>
      <div class="illustration-decoration">✦</div>
    </div>

  </section>

  <!-- INTRODUCTION -->

  <!-- CONTENU -->
  <div class="recipe-detail-content">

    <!-- INGREDIENTS -->
    <section class="detail-card ingredients-card">

      <div class="detail-section-heading">
        <div class="detail-icon">🥕</div>

        <div>
          <span class="detail-small-label">AVANT DE COMMENCER</span>
          <h2>Les ingrédients</h2>
        </div>
      </div>

      <ul class="ingredients-list">
        <% @recipe.ingredients.to_s.split(/,|\n/).map(&:strip).reject(&:blank?).each do |ingredient| %>
          <li><%= ingredient %></li>
        <% end %>
      </ul>

    </section>

    <!-- PREPARATION -->
    <section class="detail-card preparation-card">

      <div class="detail-section-heading">
        <div class="detail-icon">👨‍🍳</div>

        <div>
          <span class="detail-small-label">ÉTAPE PAR ÉTAPE</span>
          <h2>La préparation</h2>
        </div>
      </div>

      <ol class="steps-list">
        <% @recipe.steps.to_s.lines.map(&:strip).reject(&:blank?).each do |step| %>
          <li><%= step.sub(/\A\d+[.)]\s*/, "") %></li>
        <% end %>
      </ol>

    </section>

  </div>

  <!-- INTRODUCTION -->
  <div class="recipe-welcome">
    <span>👨‍🍳</span>
    <p>Enfilez votre tablier, c'est parti !</p>
  </div>

  <!-- FOOTER -->
  <footer class="recipe-detail-footer">
    <span>❤️</span>
    <p>La cuisine est encore meilleure quand elle est partagée.</p>
    <strong>MINI GASTON</strong>
  </footer>

</div>
