
<nav class="navbar navbar-lewagon">
  <div class="container-fluid">

    <!-- ACCUEIL - LOGO -->

    <%= link_to root_path,
        class: "navbar-brand",
        data: { tooltip: "Accueil" },
        aria: { label: "Accueil" } do %>

      <%= image_tag "logo.png", alt: "Mini Gaston" %>

    <% end %>

    <div class="navbar-collapse">
      <ul class="navbar-nav">

        <% if user_signed_in? %>

          <!-- MA CUISINE -->

          <li class="nav-item">

            <%= link_to dashboard_path,
                class: "navbar-custom-link #{'active' if current_page?(dashboard_path)}",
                data: { tooltip: "Ma cuisine" },
                aria: { label: "Ma cuisine" } do %>

              <svg viewBox="0 0 24 24"
                   fill="none"
                   stroke="currentColor"
                   stroke-linecap="round"
                   stroke-linejoin="round"
                   aria-hidden="true">

                <path d="M3 11h18"/>
                <path d="M5 11v6a3 3 0 0 0 3 3h8a3 3 0 0 0 3-3v-6"/>
                <path d="M2 14h3"/>
                <path d="M19 14h3"/>
                <path d="M7 7h10"/>
                <path d="M10 4h4v3"/>

              </svg>

            <% end %>

          </li>

          <!-- MES RECETTES -->

          <li class="nav-item">

            <%= link_to recipes_path,
                class: "navbar-custom-link #{'active' if current_page?(recipes_path)}",
                data: { tooltip: "Mes recettes" },
                aria: { label: "Mes recettes" } do %>

              <svg viewBox="0 0 24 24"
                   fill="none"
                   stroke="currentColor"
                   stroke-linecap="round"
                   stroke-linejoin="round"
                   aria-hidden="true">

                <path d="M12 7v14"/>
                <path d="M3 4h4a5 5 0 0 1 5 3
                         5 5 0 0 1 5-3h4v14h-4
                         a5 5 0 0 0-5 3
                         5 5 0 0 0-5-3H3z"/>

              </svg>

            <% end %>

          </li>

          <!-- NOUVELLE CONVERSATION -->

          <li class="nav-item">

            <%= button_to chats_path,
                method: :post,
                class: "navbar-custom-link",
                data: { tooltip: "Nouvelle conversation" },
                aria: { label: "Nouvelle conversation" } do %>

              <svg viewBox="0 0 24 24"
                   fill="none"
                   stroke="currentColor"
                   stroke-linecap="round"
                   stroke-linejoin="round"
                   aria-hidden="true">

                <path d="M21 11.5a8.5 8.5 0 0 1-8.5 8.5
                         9 9 0 0 1-4-.9L3 21l1.9-5.5
                         a9 9 0 0 1-.9-4A8.5 8.5 0 0 1
                         12.5 3h.5a8.5 8.5 0 0 1 8 8z"/>

              </svg>

            <% end %>

          </li>

          <!-- HISTORIQUE DES CONVERSATIONS -->

          <li class="nav-item">

            <%= link_to chats_path,
                class: "navbar-custom-link #{'active' if controller_name == 'chats' && action_name == 'index'}",
                data: { tooltip: "Historique des conversations" },
                aria: { label: "Historique des conversations" } do %>

              <svg xmlns="http://www.w3.org/2000/svg"
                   viewBox="0 0 24 24"
                   fill="none"
                   stroke="currentColor"
                   stroke-linecap="round"
                   stroke-linejoin="round"
                   aria-hidden="true">

                <path d="M3 12a9 9 0 1 0 9-9
                         9.75 9.75 0 0 0-6.74 2.74L3 8"/>

                <path d="M3 3v5h5"/>

                <path d="M12 7v5l4 2"/>

              </svg>

            <% end %>

          </li>

          <!-- PHOTO DE PROFIL -->

          <li class="nav-item dropdown navbar-profile">

            <button type="button"
                    class="dropdown-toggle"
                    data-bs-toggle="dropdown"
                    aria-expanded="false"
                    aria-label="Mon compte">

              <% if current_user.respond_to?(:photo) && current_user.photo.attached? %>

                <%= image_tag current_user.photo,
                    class: "avatar",
                    alt: "Mon profil" %>

              <% else %>

                <span class="avatar d-flex align-items-center justify-content-center"
                      style="background: #e8eee3; color: #365b40;">

                  <%= current_user.first_name.to_s.first.to_s.upcase %>

                </span>

              <% end %>

            </button>

            <!-- MENU DE DECONNEXION -->

            <div class="dropdown-menu">

              <%= button_to destroy_user_session_path,
                  method: :delete,
                  class: "dropdown-item" do %>

                <svg viewBox="0 0 24 24"
                     width="18"
                     height="18"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.6"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     aria-hidden="true">

                  <path d="M10 17l5-5-5-5"/>
                  <path d="M15 12H3"/>
                  <path d="M14 3h5a2 2 0 0 1 2 2v14
                           a2 2 0 0 1-2 2h-5"/>

                </svg>

                Se déconnecter

              <% end %>

            </div>

          </li>

        <% else %>

          <!-- CONNEXION -->

          <li class="nav-item">

            <%= link_to new_user_session_path,
                class: "navbar-login-button",
                data: { tooltip: "Se connecter" },
                aria: { label: "Se connecter" } do %>

              <svg viewBox="0 0 24 24"
                   fill="none"
                   stroke="currentColor"
                   stroke-linecap="round"
                   stroke-linejoin="round"
                   aria-hidden="true">

                <circle cx="12" cy="8" r="4"/>
                <path d="M4 21v-2a6 6 0 0 1 6-6h4
                         a6 6 0 0 1 6 6v2"/>

              </svg>

            <% end %>

          </li>

        <% end %>

      </ul>
    </div>

  </div>
</nav>
